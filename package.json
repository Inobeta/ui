    "karma-coverage": "^2.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^21.2.7",
    "oxc-parser": "0.121.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.5",
    "ts-node": "~4.1.0",
    "typescript": "~5.9.2",
    "zone.js": "^0.16.2"
  },
  "peerDependencies": {
    "@ngrx/effects": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "@ngx-translate/core": "^16.x.x",
    "@ngx-translate/http-loader": "^16.x.x",
