    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "protractor": "0.0.0"
  },
  "dependencies": {
    "tslib": "^2.4.0"
  },
  "exports": {
    ".": {
      "sass": "./_index.scss"
    }
  },
  "repository": {
    "type": "git",
