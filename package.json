{
  "name": "@inobeta/ui",
  "version": "19.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --disable-host-check",
    "build": "ng build --configuration production",
    "test": "ng test  --code-coverage",
    "test-ci": "ng test  --code-coverage --watch=false",
    "test-with-diagnostic": "ng test --sourceMap=false",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "packagr": "ng-packagr -p ng-package.json",
    "release": "npm run packagr && cd dist/ && npm pack",
    "doc": "compodoc -p tsconfig.doc.json --disableCoverage --disableDomTree --disableGraph --hideGenerator --theme readthedocs",
    "pre-release": "npm version --no-git-tag-version prerelease",
    "storybook": "ng run ui:storybook",
    "build-storybook": "ng run ui:build-storybook",
    "patch": "npm version --no-git-tag-version patch",
    "minor": "npm version --no-git-tag-version minor",
    "major": "npm version --no-git-tag-version major"
  },
  "private": false,
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.4",
    "@angular/animations": "^19.0.3",
    "@angular/cdk": "^19.0.2",
    "@angular/cli": "^19.0.4",
    "@angular/common": "^19.0.3",
    "@angular/compiler": "^19.0.3",
    "@angular/compiler-cli": "^19.0.3",
    "@angular/core": "^19.0.3",
    "@angular/forms": "^19.0.3",
    "@angular/language-service": "^19.0.3",
    "@angular/material": "^19.0.2",
    "@angular/platform-browser": "^19.0.3",
    "@angular/platform-browser-dynamic": "^19.0.3",
    "@angular/router": "^19.0.3",
    "@babel/preset-env": "^7.15.0",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/addon-mdx-gfm": "^8.4.7",
    "@storybook/angular": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.2",
    "@types/node": "^20.10.0",
    "jasmine-core": "^4.1.1",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "^2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.6.0",
    "ng-packagr": "^19.0.1",
    "storybook": "^8.4.7",
    "ts-node": "~4.1.0",
    "typescript": "~5.5.3"
  },
  "peerDependencies": {
    "@ngrx/effects": "^19.0.0-rc.0",
    "@ngrx/store": "^19.0.0-rc.0",
    "@ngrx/store-devtools": "^19.0.0-rc.0",
    "@ngx-translate/core": "^15.x.x",
    "@ngx-translate/http-loader": "^8.x.x",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.1",
    "jwt-decode": "^4.0.0",
    "papaparse": "^5.3.1",
    "rxjs": "^7.x.x",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.15.0"
  },
  "overrides": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "protractor": "0.0.0"
  },
  "dependencies": {
    "tslib": "^2.4.0"
  },
  "exports": {
    ".": {
      "sass": "./_index.scss"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inobeta/ui.git"
  },
  "license": "MIT"
}
