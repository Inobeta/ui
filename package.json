{
  "name": "@inobeta/ui",
  "version": "20.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "test": "ng test  --code-coverage",
    "test-ci": "ng test  --code-coverage --watch=false",
    "test-with-diagnostic": "ng test --sourceMap=false",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "packagr": "ng-packagr -p ng-package.json",
    "release": "npm run packagr && cd dist/ && npm pack",
    "doc": "compodoc -p tsconfig.doc.json --disableCoverage --disableDomTree --disableGraph --hideGenerator --theme readthedocs",
    "pre-release": "npm version --no-git-tag-version prerelease",
    "storybook": "ng run ui:storybook",
    "build-storybook": "ng run ui:build-storybook",
    "patch": "npm version --no-git-tag-version patch",
    "minor": "npm version --no-git-tag-version minor",
    "major": "npm version --no-git-tag-version major"
  },
  "private": false,
  "devDependencies": {
    "@angular-devkit/architect": "^0.2003.1",
    "@angular-devkit/core": "^20.3.1",
    "@angular/animations": "^20.3.0",
    "@angular/build": "^20.3.1",
    "@angular/cdk": "^20.2.2",
    "@angular/cli": "^20.3.1",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/language-service": "^20.3.0",
    "@angular/material": "^20.2.2",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@babel/preset-env": "^7.15.0",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-docs": "^9.1.5",
    "@storybook/addon-essentials": "^9.0.0-alpha.12",
    "@storybook/addon-interactions": "^9.0.0-alpha.10",
    "@storybook/addon-links": "^9.1.5",
    "@storybook/addon-mdx-gfm": "^9.0.0-alpha.13",
    "@storybook/angular": "^9.1.5",
    "@storybook/blocks": "^9.0.0-alpha.17",
    "@storybook/manager-api": "^9.0.0-alpha.1",
    "@storybook/mdx2-csf": "^1.1.0",
    "@storybook/test": "^9.0.0-alpha.2",
    "@storybook/theming": "^9.0.0-alpha.1",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jasmine-core": "^4.1.1",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "6.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "^2.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^20.3.0",
    "storybook": "^9.1.5",
    "ts-node": "~4.1.0",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "@ngrx/effects": "^20.0.1",
    "@ngrx/store": "^20.0.1",
    "@ngrx/store-devtools": "^20.0.1",
    "@ngx-translate/core": "^16.x.x",
