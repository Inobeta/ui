{
  "name": "@inobeta/ui",
  "version": "21.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "test": "ng test  --code-coverage",
    "test-ci": "ng test  --code-coverage --watch=false",
    "test-with-diagnostic": "ng test --sourceMap=false",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "packagr": "ng-packagr -p ng-package.json",
    "release": "npm run packagr && cd dist/ && npm pack",
    "doc": "compodoc -p tsconfig.doc.json --disableCoverage --disableDomTree --disableGraph --hideGenerator --theme readthedocs",
    "pre-release": "npm version --no-git-tag-version prerelease",
    "storybook": "ng run ui:storybook",
    "build-storybook": "ng run ui:build-storybook",
    "patch": "npm version --no-git-tag-version patch",
    "minor": "npm version --no-git-tag-version minor",
    "major": "npm version --no-git-tag-version major"
  },
  "private": false,
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.20",
    "@angular-devkit/core": "^21.2.20",
    "@angular/animations": "^21.2.19",
    "@angular/build": "^21.2.20",
    "@angular/cdk": "^21.2.14",
    "@angular/cli": "^21.2.20",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/language-service": "^21.2.19",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@babel/preset-env": "^7.15.0",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/angular-vite": "^10.5.5",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "angular-eslint": "^21.4.0",
    "canvg": "^3.0.11",
    "core-js": "^3.6.0",
    "dompurify": "^3.2.4",
    "eslint": "^9.39.5",
